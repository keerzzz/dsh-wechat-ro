  "scripts": {
    "check": "node scripts/check-structure.mjs",
    "smoke:host": "node scripts/smoke-host.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:ci": "node scripts/run-ci.mjs",
    "test:client": "node scripts/run-tests.mjs --only test-conversation-client",
    "test:local-history": "node scripts/run-tests.mjs --only test-local-history",
    "runtime": "node scripts/sync-local-history-runtime.mjs",
    "test:unconfigured": "node --unhandled-rejections=strict --test scripts/test-unconfigured-deployment.mjs",
    "test:native-unconfigured": "node --unhandled-rejections=strict --test scripts/test-native-unconfigured.mjs",
    "test:host": "node scripts/test-host-hardening.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "test:channel": "node scripts/test-channel.mjs",
    "test:weixin-api": "node --unhandled-rejections=strict --test scripts/test-weixin-api.mjs",
    "test:weixin-channel": "node --unhandled-rejections=strict --test scripts/test-weixin-channel.mjs",
    "test:weixin-updates-diagnostic": "node --unhandled-rejections=strict --test scripts/test-weixin-updates-diagnostic.mjs",
    "test:weixin-dsh": "node --unhandled-rejections=strict --test scripts/test-weixin-dsh.mjs",
    "test:weixin-admin": "node --unhandled-rejections=strict --test scripts/test-weixin-admin.mjs",
    "test:weixin-admin-ui": "node --unhandled-rejections=strict --test scripts/test-weixin-admin-ui.mjs",
    "test:weixin-admin-host": "node --unhandled-rejections=strict --test scripts/test-weixin-admin-host.mjs",
    "test:data": "node scripts/test-data-hardening.mjs",
    "types:check": "tsc -p tsconfig.json --noEmit",
    "types": "tsc -p tsconfig.json",
    "check:quality": "node scripts/check-quality.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keerzzz/dsh-wechat-ro.git",
    "directory": "plugin"
