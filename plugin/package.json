  "files": [
    "runtime/*.py",
    "lib/conversation-controller.js",
    "lib/conversation-wire.js",
    "lib/session-bridge.js",
    "lib/native-session-bridge.js",
    "lib/session-bridge-agent.js",
    "lib/task-access.js",
